{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--no-install", "netlify", "dev", "--offline", "--port", "8888", "--framework", "#custom", "--command", "npm run dev", "--target-port", "5173", "--internal-disable-edge-functions"],
      "port": 8888
    },
    {
      "name": "design-docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4178", "--directory", "design"],
      "port": 4178,
      "url": "http://localhost:4178"
    }
  ]
}
